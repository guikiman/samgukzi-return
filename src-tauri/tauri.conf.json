{
  "$schema": "https://schema.tauri.app/config/v2",
  "productName": "rtk8-clone",
  "version": "1.0.1",
  "identifier": "com.rtk8.clone",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/prepare_tauri_assets.mjs",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../tauri-assets"
  },
  "app": {
    "windows": [
      {
        "title": "삼국지 8 리메이크 초정밀 클론",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
