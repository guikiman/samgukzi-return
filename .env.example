# Supabase Auth & Cloud Save Configuration
# Copy this file to .env and fill in your Supabase project values.

# Supabase project URL (must start with https://)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / public API key (safe for browser client distribution)
# NEVER put service_role or secret keys in this variable!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
