#!/bin/sh
# 파생작 자산이 리모트로 나가지 못하게 한다.
# 설치: core.hooksPath 설정 또는 .git/hooks/pre-push 로 복사.
#
# 세 층을 함께 돌린다.
#   1) 히스토리 스캔 — china-national-map.png (파생 지도) 가 되살아나는 것을
#      경로와 blob id 양쪽으로 막는다.
#   2) 자산 대장   — 지금 커밋되는 바이너리 자산이 출처 기록이 없거나 미확인이면 막는다.
#      1층은 "이미 들어간 것"만 본다. 새 자산은 조용히 통과한다. 실제로 AI 원화 지도가
#      그렇게 커밋되었고 아무도 알 수 없었다. 그래서 2층이 필요하다.
#   3) 메타데이터  — EXIF/XMP/문자열 청크가 남으면 생성 도구명이나 원본 파일명이
#      그대로 드러난다. 구조를 파싱하므로 눈에 보이지 않는 압축 청크도 잡는다.
set -e
ROOT="$(git rev-parse --show-toplevel)"
node "$ROOT/scripts/check_ip_assets.mjs"
node "$ROOT/scripts/check_ip_assets.mjs" --provenance
# 3) 메타데이터 잔여 — 생성 도구명이나 원본 파일명이 남아 있으면 그것만으로
#    출처가 드러난다. 구조 파싱이라 PNG zTXt/iTXt, WebP EXIF/XMP, JPEG APP1 을 잡는다.
node "$ROOT/scripts/inspect_image_metadata.mjs" --fail-on-meta
